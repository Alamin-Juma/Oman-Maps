{
  "name": "@dunialab/api",
  "version": "0.1.0",
  "private": true,
  "description": "DuniaLab backend: consent, child profiles, offline-first event sync, reports and the guarded AI explanation check.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate.js"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@dunialab/content": "^0.1.0",
    "@dunialab/mastery": "^0.1.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
