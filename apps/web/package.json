{
  "name": "@dunialab/web",
  "version": "0.1.0",
  "private": true,
  "description": "Tier C (2D map, any browser) and the family area: play missions offline, sync, parent report.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/vitest.mjs run",
    "basemap": "node scripts/build-basemap.mjs",
    "dev:phone": "node scripts/dev-phone.mjs"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@dunialab/content": "^0.1.0",
    "@dunialab/mastery": "^0.1.0",
    "@dunialab/mission": "^0.1.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "d3-geo": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  }
}
