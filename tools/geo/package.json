{
  "name": "@dunialab/geo",
  "version": "0.2.0",
  "private": true,
  "description": "Geodata generator for 3D assets (ADR-0009): reads content packs, writes terrain tiles, baked textures, rivers and lakes per pack, with a manifest.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/vitest.mjs run",
    "generate": "node dist/cli.js build",
    "verify": "node dist/cli.js verify",
    "unity": "node dist/cli.js unity",
    "spike:cog": "node spikes/cog-window.mjs"
  },
  "dependencies": {
    "@dunialab/content": "0.1.0"
  },
  "devDependencies": {
    "geotiff": "3.0.5",
    "sharp": "0.35.5"
  }
}
